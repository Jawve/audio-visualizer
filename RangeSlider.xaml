<UserControl x:Class="test.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40"
        MinWidth="180">
    <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="#000000"
                CornerRadius="6"
                Height="8"
                VerticalAlignment="Center"/>

        <Canvas x:Name="Track"
                Height="8"
                VerticalAlignment="Center">
            <Rectangle x:Name="Sel"
                    Height="8"
                    Fill="{DynamicResource AccentOrangeBrush}"/>
            <Thumb x:Name="ThumbMin"
                    Width="12"
                    Height="18"
                    Cursor="SizeWE"
                    Background="#222"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"/>
            <Thumb x:Name="ThumbMax"
                    Width="12"
                    Height="18"
                    Cursor="SizeWE"
                    Background="#222"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"/>
        </Canvas>
    </Grid>
</UserControl>