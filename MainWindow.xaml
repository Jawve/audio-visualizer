<Window x:Class="test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:test"
        Title="Audio Visual Sandbox"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Grid>
        <!-- Animated background layer -->
        <local:AnimatedBackground />

        <!-- Foreground layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Visualizer area -->
            <Grid Grid.Row="0" Margin="12">
                <local:BarsControl x:Name="Bars"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Content="Pop out visualizer" Click="PopOut"/>
                </StackPanel>
            </Grid>

            <!-- Controls area -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="16"
                        Background="#20181F35"
                        BorderBrush="#50803AB4"
                        BorderThickness="1.2"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Playback Device" Opacity="0.85"/>
                        <ComboBox x:Name="DeviceCombo" Margin="0,6,0,0"/>

                        <Separator Margin="0,10,0,6" Opacity="0.3"/>
                        <TextBlock Text="Sensitivity" Opacity="0.85"/>
                        <Slider x:Name="SensSlider" Minimum="0.05" Maximum="4" Value="1"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" CornerRadius="16" Background="#15101C" Opacity="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>