<Window x:Class="test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:test"
        Title="Window Visualizer"
                Height="720"
                Width="1200"
        Background="{DynamicResource AppWindowBackgroundBrush}">

        <!-- Only vertical scrollbars are thicker in THIS window -->
        <Window.Resources>
                <Style TargetType="ScrollBar"
                                BasedOn="{StaticResource {x:Type ScrollBar}}">
                        <Style.Triggers>
                                <Trigger Property="Orientation"
                                                Value="Vertical">
                                        <Setter Property="Width"
                                                        Value="8"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- VISUALIZER -->
                <Grid Grid.Row="0"
                                Grid.ColumnSpan="2"
                                ClipToBounds="True">
                        <local:AnimatedBackground x:Name="AnimBg"/>
                        <local:BarsControl x:Name="Bars"/>
                </Grid>

                <!-- LEFT PANEL -->
                <Border Grid.Row="1"
                                Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        Padding="16"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="0,1,1,0">
                        <ScrollViewer x:Name="LeftScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      Padding="0,0,10,0"
                                      PreviewMouseWheel="LeftScroll_PreviewMouseWheel">
                                <StackPanel Orientation="Vertical">

                                        <TextBlock Text="Device"
                                                        FontWeight="SemiBold"
                                                        Margin="0,0,0,6"/>

                                        <!-- Device Combo -->
                                        <ComboBox x:Name="DeviceCombo"
                                                        Margin="0,0,0,10"
                                                  Foreground="{DynamicResource OnSurfaceBrush}"
                                                  BorderBrush="{DynamicResource OutlineBrush}">
                                                <ComboBox.Resources>
                                                        <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Background"
                                                                                Value="Black"/>
                                                                <Setter Property="Foreground"
                                                                                Value="{DynamicResource OnSurfaceBrush}"/>
                                                                <Setter Property="Padding"
                                                                                Value="8,4"/>
                                                                <Setter Property="FocusVisualStyle"
                                                                                Value="{x:Null}"/>
                                                                <Setter Property="Template">
                                                                        <Setter.Value>
                                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                                        <Border x:Name="Bd"
                                                                                                        Background="{TemplateBinding Background}"
                                                                                                        Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsHighlighted"
                                                                                                                Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="#341846"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsSelected"
                                                                                                                Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="#2A1438"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Style>
                                                        <Style TargetType="ListBoxItem">
                                                                <Setter Property="Background"
                                                                                Value="Black"/>
                                                                <Setter Property="Foreground"
                                                                                Value="{DynamicResource OnSurfaceBrush}"/>
                                                                <Setter Property="Padding"
                                                                                Value="8,4"/>
                                                                <Setter Property="FocusVisualStyle"
                                                                                Value="{x:Null}"/>
                                                                <Setter Property="Template">
                                                                        <Setter.Value>
                                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                                        <Border x:Name="Bd"
                                                                                                        Background="{TemplateBinding Background}"
                                                                                                        Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsMouseOver"
                                                                                                                Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="#341846"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsSelected"
                                                                                                                Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="#2A1438"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Style>
                                                </ComboBox.Resources>

                                                <ComboBox.Template>
                                                        <ControlTemplate TargetType="ComboBox">
                                                                <Grid>
                                                                        <!-- Selection box (BLACK; turns purple when open) -->
                                                                        <Border x:Name="SelectionBox"
                                                                                Background="Black"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                Padding="10,6,30,6"
                                                                                        CornerRadius="6">
                                                                                <Grid>
                                                                                        <ContentPresenter Margin="0"
                                                                                                          HorizontalAlignment="Left"
                                                                                                          VerticalAlignment="Center"
                                                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                                                                        <Path HorizontalAlignment="Right"
                                                                                                        Margin="0,0,10,0"
                                                                                              VerticalAlignment="Center"
                                                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                                                                        Width="10"
                                                                                                        Height="6"
                                                                                              Fill="{DynamicResource OnSurfaceBrush}"/>
                                                                                </Grid>
                                                                        </Border>

                                                                        <!-- Invisible toggle: kills OS hover visuals -->
                                                                        <ToggleButton x:Name="Toggle"
                                                                                      Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                      Focusable="False"
                                                                                        ClickMode="Press"
                                                                                      HorizontalAlignment="Stretch"
                                                                                        VerticalAlignment="Stretch"
                                                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                                <ToggleButton.Template>
                                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                                <Border Background="Transparent"/>
                                                                                        </ControlTemplate>
                                                                                </ToggleButton.Template>
                                                                        </ToggleButton>

                                                                        <!-- Popup -->
                                                                        <Popup x:Name="Popup"
                                                                               Placement="Bottom"
                                                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                               StaysOpen="False"
                                                                               AllowsTransparency="True"
                                                                                        PopupAnimation="Slide">
                                                                                <Border Background="Black"
                                                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                                                        BorderThickness="1"
                                                                                                CornerRadius="6"
                                                                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                                                        <ScrollViewer CanContentScroll="True"
                                                                                                        Background="Black">
                                                                                                <ItemsPresenter/>
                                                                                        </ScrollViewer>
                                                                                </Border>
                                                                        </Popup>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsDropDownOpen"
                                                                                        Value="True">
                                                                                <Setter TargetName="SelectionBox"
                                                                                                Property="Background"
                                                                                                Value="#2A1438"/>
                                                                        </Trigger>
                                                                </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                </ComboBox.Template>
                                        </ComboBox>

                                        <TextBlock Text="Sensitivity"
                                                        FontWeight="SemiBold"
                                                        Margin="0,6,0,6"/>
                                        <Slider x:Name="SensSlider"
                                                        Minimum="0.05"
                                                        Maximum="4.0"
                                                        Value="1.0"
                                                        Margin="0,0,0,10"/>

                                        <TextBlock Text="Volume (dB)"
                                                        FontWeight="SemiBold"
                                                        Margin="0,6,0,6"/>
                                        <Slider x:Name="VolSlider"
                                                        Minimum="-24"
                                                        Maximum="24"
                                                        TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True"
                                                        Margin="0,0,0,6"/>

                                        <TextBlock Text="Tip: Mouse wheel over the visualizer to adjust volume."
                                                        Opacity="0.7"
                                                        Margin="0,0,0,12"/>

                                        <Separator Margin="0,10,0,10"/>

                                        <DockPanel LastChildFill="False">
                                                <TextBlock Text="Layers"
                                                                FontWeight="SemiBold"
                                                                DockPanel.Dock="Left"/>
                                                <Button x:Name="BtnHelp"
                                                                Content="?"
                                                                Width="32"
                                                                Height="28"
                                                                Margin="6,0,0,0"
                                                                Click="BtnHelp_Click"/>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal"
                                                        Margin="0,6,0,6">
                                                <Button x:Name="BtnAddLayer"
                                                                Content="Add Image"
                                                                Margin="0,0,6,0"/>
                                                <Button x:Name="BtnDeleteLayer"
                                                                Content="Delete"
                                                                Margin="0,0,6,0"/>
                                                <Button x:Name="BtnUp"
                                                                Content="Up"
                                                                Margin="0,0,6,0"/>
                                                <Button x:Name="BtnDown"
                                                                Content="Down"/>
                                        </StackPanel>

                                        <ListBox x:Name="LayerList"
                                                        Height="170"
                                                        Margin="0,0,0,8"
                                                        Background="#0A0A0A"
                                                        BorderBrush="{StaticResource OutlineBrush}">
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Img"
                                                                                        Opacity="0.8"
                                                                                        Width="28"/>
                                                                        <TextBlock Text="|"
                                                                                        Opacity="0.4"
                                                                                        Margin="6,0,0,0"/>
                                                                        <TextBlock Text="{Binding SourcePath}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        Width="180"
                                                                                        Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="Tools"
                                                        FontWeight="SemiBold"
                                                        Margin="0,8,0,6"/>
                                        <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,8">
                                                <Button x:Name="BtnFlipH"
                                                                Content="Flip H"
                                                                Margin="0,0,6,0"/>
                                                <Button x:Name="BtnFlipV"
                                                                Content="Flip V"/>
                                        </StackPanel>

                                        <TextBlock Text="Frequency Range (Hz)"
                                                        FontWeight="SemiBold"/>
                                        <local:RangeSlider x:Name="FreqSlider"
                                                        Margin="0,6,0,4"/>
                                        <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,8">
                                                <TextBlock Text="Min:"
                                                                Opacity="0.8"/>
                                                <TextBlock x:Name="LblMin"
                                                                Width="60"
                                                                Margin="6,0,0,0"/>
                                                <TextBlock Text="Max:"
                                                                Opacity="0.8"
                                                                Margin="12,0,0,0"/>
                                                <TextBlock x:Name="LblMax"
                                                                Width="60"
                                                                Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="Sensitivity / Volume"
                                                        FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal"
                                                        Margin="0,6,0,0">
                                                <Slider x:Name="LayerSens"
                                                                Minimum="0.2"
                                                                Maximum="3.0"
                                                                Value="1.0"
                                                                Width="120"/>
                                                <Slider x:Name="LayerGain"
                                                                Minimum="0.3"
                                                                Maximum="2.5"
                                                                Value="1.0"
                                                                Width="120"
                                                                Margin="8,0,0,0"/>
                                        </StackPanel>

                                </StackPanel>
                        </ScrollViewer>
                </Border>

                <!-- RIGHT: boxed Sandbox -->
                <Border Grid.Row="1"
                                Grid.Column="1"
                        Background="#0C0C0C"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8"
                                Padding="8"
                                ClipToBounds="True">
                        <Grid>
                                <local:SandboxControl x:Name="Sandbox"
                                                Background="Transparent"/>
                        </Grid>
                </Border>
        </Grid>
</Window>
