<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- System dark for popups (prevents white menus) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                        Color="#000000"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                        Color="#000000"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                        Color="#202020"/>

        <!-- Palette -->
        <Color x:Key="Surface">#FF16131B</Color>
        <Color x:Key="SurfaceAlt">#FF1E1A24</Color>
        <Color x:Key="OnSurface">#FFF3F3F6</Color>
        <Color x:Key="Outline">#40FFFFFF</Color>
        <Color x:Key="AccentOrange">#FFFF7A1A</Color>
        <Color x:Key="PurpleSel">#2A1438</Color>
        <Color x:Key="PurpleHover">#341846</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="SurfaceBrush"
                        Color="{StaticResource Surface}"/>
        <SolidColorBrush x:Key="SurfaceAltBrush"
                        Color="{StaticResource SurfaceAlt}"/>
        <SolidColorBrush x:Key="OnSurfaceBrush"
                        Color="{StaticResource OnSurface}"/>
        <SolidColorBrush x:Key="OutlineBrush"
                        Color="{StaticResource Outline}"/>
        <SolidColorBrush x:Key="AccentOrangeBrush"
                        Color="{StaticResource AccentOrange}"/>

        <!-- Background -->
        <LinearGradientBrush x:Key="AppWindowBackgroundBrush"
                        StartPoint="0,0"
                        EndPoint="1,1">
                <GradientStop Color="#20131E"
                                Offset="0"/>
                <GradientStop Color="#1A121B"
                                Offset="1"/>
        </LinearGradientBrush>

        <!-- Base text -->
        <Style TargetType="Control">
                <Setter Property="FontFamily"
                                Value="Segoe UI Variable Text, Segoe UI, Bahnschrift"/>
                <Setter Property="Foreground"
                                Value="{StaticResource OnSurfaceBrush}"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
        </Style>
        <Style TargetType="TextBlock">
                <Setter Property="FontFamily"
                                Value="Segoe UI Variable Text, Segoe UI, Bahnschrift"/>
                <Setter Property="Foreground"
                                Value="{StaticResource OnSurfaceBrush}"/>
                <Setter Property="TextWrapping"
                                Value="Wrap"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
                <Setter Property="Background"
                                Value="Black"/>
                <Setter Property="BorderBrush"
                                Value="{StaticResource OutlineBrush}"/>
                <Setter Property="BorderThickness"
                                Value="1"/>
                <Setter Property="Padding"
                                Value="12,8"/>
                <Setter Property="MinHeight"
                                Value="32"/>
                <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                <Setter Property="Cursor"
                                Value="Hand"/>
                <Setter Property="SnapsToDevicePixels"
                                Value="True"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="root"
                                                        CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                                Value="True">
                                                        <Setter TargetName="root"
                                                                        Property="BorderBrush"
                                                                        Value="{StaticResource AccentOrangeBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                                Value="True">
                                                        <Setter TargetName="root"
                                                                        Property="Background"
                                                                        Value="#101010"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled"
                                                                Value="False">
                                                        <Setter TargetName="root"
                                                                        Property="Opacity"
                                                                        Value="0.55"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ComboBox rows: dark purple hover/selected (no bright blue) -->
        <Style TargetType="ComboBoxItem">
                <Setter Property="Background"
                                Value="Black"/>
                <Setter Property="Foreground"
                                Value="{StaticResource OnSurfaceBrush}"/>
                <Setter Property="Padding"
                                Value="8,4"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                <Style.Triggers>
                        <Trigger Property="IsHighlighted"
                                        Value="True">
                                <Setter Property="Background"
                                                Value="#341846"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                        Value="True">
                                <Setter Property="Background"
                                                Value="#2A1438"/>
                        </Trigger>
                </Style.Triggers>
        </Style>
        <!-- ListBoxItem too (ComboBox popup uses this) -->
        <Style TargetType="ListBoxItem">
                <Setter Property="Background"
                                Value="Black"/>
                <Setter Property="Foreground"
                                Value="{StaticResource OnSurfaceBrush}"/>
                <Setter Property="Padding"
                                Value="8,4"/>
                <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                        Value="True">
                                <Setter Property="Background"
                                                Value="#341846"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                        Value="True">
                                <Setter Property="Background"
                                                Value="#2A1438"/>
                        </Trigger>
                </Style.Triggers>
        </Style>

        <!-- Invisible RepeatButton (used by ScrollBar Track) -->
        <Style x:Key="InvisibleRepeatButton"
                        TargetType="RepeatButton">
                <Setter Property="Background"
                                Value="Transparent"/>
                <Setter Property="BorderThickness"
                                Value="0"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- ScrollBars: ultra-slim pill; NO track hover -->
        <ControlTemplate x:Key="PillThumbTemplate"
                        TargetType="Thumb">
                <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"/>
                <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging"
                                        Value="True">
                                <Setter TargetName="pill"
                                                Property="Background"
                                                Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
                <Setter Property="Background"
                                Value="Transparent"/>
                <Setter Property="Foreground"
                                Value="#17141B"/>
                <!-- 1px track -->
                <Setter Property="Width"
                                Value="4"/>
                <!-- default thin; we’ll widen vertical in MainWindow only -->
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                        <Grid>
                                                <!-- Vertical default -->
                                                <Border x:Name="TrackLine"
                                                                Background="{TemplateBinding Foreground}"
                                                        Width="1"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Stretch"
                                                                CornerRadius="1"/>
                                                <Track x:Name="PART_Track"
                                                                IsDirectionReversed="false">
                                                        <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                                              Style="{StaticResource InvisibleRepeatButton}"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                                              Style="{StaticResource InvisibleRepeatButton}"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                                <Thumb x:Name="BarThumb"
                                                                       Background="#3A3742"
                                                                       BorderBrush="{StaticResource OutlineBrush}"
                                                                       BorderThickness="1"
                                                                       MinHeight="18"
                                                                                MinWidth="18"
                                                                       Template="{StaticResource PillThumbTemplate}"/>
                                                        </Track.Thumb>
                                                </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <!-- Horizontal -->
                                                <Trigger Property="Orientation"
                                                                Value="Horizontal">
                                                        <Setter TargetName="TrackLine"
                                                                        Property="Width"
                                                                        Value="Auto"/>
                                                        <Setter TargetName="TrackLine"
                                                                        Property="Height"
                                                                        Value="1"/>
                                                        <Setter Property="Height"
                                                                        Value="4"/>
                                                        <Setter Property="Width"
                                                                        Value="Auto"/>
                                                        <Setter TargetName="BarThumb"
                                                                        Property="Height"
                                                                        Value="4"/>
                                                        <Setter TargetName="BarThumb"
                                                                        Property="MinWidth"
                                                                        Value="18"/>
                                                        <Setter TargetName="BarThumb"
                                                                        Property="MinHeight"
                                                                        Value="4"/>
                                                </Trigger>
                                                <!-- Vertical -->
                                                <Trigger Property="Orientation"
                                                                Value="Vertical">
                                                        <Setter TargetName="BarThumb"
                                                                        Property="Width"
                                                                        Value="4"/>
                                                        <Setter TargetName="BarThumb"
                                                                        Property="MinHeight"
                                                                        Value="18"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- Slider: slim track + pill thumb, NO hover highlight -->
        <ControlTemplate x:Key="SliderThumbTemplate"
                        TargetType="Thumb">
                <Border x:Name="t"
                                Background="#3A3742"
                                BorderBrush="{StaticResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"/>
                <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging"
                                        Value="True">
                                <Setter TargetName="t"
                                                Property="Background"
                                                Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Slider">
                <Setter Property="Background"
                                Value="#0A0A0A"/>
                <!-- base track -->
                <Setter Property="Foreground"
                                Value="{StaticResource AccentOrangeBrush}"/>
                <!-- filled -->
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                        <Grid>
                                                <Grid x:Name="H"
                                                                Visibility="Visible">
                                                        <Border Background="{TemplateBinding Background}"
                                                                        Height="4"
                                                                        CornerRadius="2"
                                                                        VerticalAlignment="Center"/>
                                                        <Track x:Name="PART_Track"
                                                                        Height="4"
                                                                        VerticalAlignment="Center"
                                                                        IsDirectionReversed="False">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Style="{StaticResource InvisibleRepeatButton}">
                                                                                <Border Background="{TemplateBinding Foreground}"
                                                                                                Height="4"
                                                                                                CornerRadius="2"/>
                                                                        </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Style="{StaticResource InvisibleRepeatButton}">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                Height="4"
                                                                                                CornerRadius="2"/>
                                                                        </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                        <Thumb Width="12"
                                                                                        Height="12"
                                                                                        Template="{StaticResource SliderThumbTemplate}"/>
                                                                </Track.Thumb>
                                                        </Track>
                                                </Grid>
                                                <Grid x:Name="V"
                                                                Visibility="Collapsed">
                                                        <Border Background="{TemplateBinding Background}"
                                                                        Width="4"
                                                                        CornerRadius="2"
                                                                        HorizontalAlignment="Center"/>
                                                        <Track x:Name="PART_Track_V"
                                                                        Width="4"
                                                                        HorizontalAlignment="Center"
                                                                        IsDirectionReversed="True">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Style="{StaticResource InvisibleRepeatButton}">
                                                                                <Border Background="{TemplateBinding Foreground}"
                                                                                                Width="4"
                                                                                                CornerRadius="2"/>
                                                                        </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Style="{StaticResource InvisibleRepeatButton}">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                Width="4"
                                                                                                CornerRadius="2"/>
                                                                        </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                        <Thumb Width="12"
                                                                                        Height="12"
                                                                                        Template="{StaticResource SliderThumbTemplate}"/>
                                                                </Track.Thumb>
                                                        </Track>
                                                </Grid>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="Orientation"
                                                                Value="Vertical">
                                                        <Setter TargetName="H"
                                                                        Property="Visibility"
                                                                        Value="Collapsed"/>
                                                        <Setter TargetName="V"
                                                                        Property="Visibility"
                                                                        Value="Visible"/>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

</ResourceDictionary>
